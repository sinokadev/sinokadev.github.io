---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import Layout from '../../layouts/Layout.astro';

// 1. 모든 태그에 대한 정적 경로 생성
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // 모든 포스트에서 중복 없는 태그 목록 추출
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat().filter(tag => tag))];

  // 각 태그별로 페이지 경로와 해당 태그의 포스트들을 매핑
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

// 2. 경로 파라미터와 전달받은 props 가져오기
const { tag } = Astro.params;
const { posts } = Astro.props;

// 날짜순 정렬 (최신순)
const sortedPosts = posts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageTitle = `#${tag} 포스트 | ${SITE_TITLE}`;
---

<Layout title={pageTitle} description={`${tag} 태그와 관련된 글 목록입니다.`}>

	<h1>#{tag} 태그가 달린 글</h1>

	<ul>
		{sortedPosts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>{post.data.title}</a>
				<div class="date">
					{post.data.pubDate.toLocaleDateString('ko-KR', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</div>
			</li>
		))}
	</ul>

	<a href="/tags/">모든 태그 보기</a>
</Layout>