---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
					/* 고정 너비 대신 최대 너비를 지정하고 100%를 줘서 반응형으로 대응 */
					width: 100%;
					max-width: 960px;
					margin: 0 auto;
					padding: 0 20px; /* 양옆에 여백을 줘서 글자가 화면 끝에 붙지 않게 함 */
					box-sizing: border-box; /* 패딩이 너비에 포함되도록 설정 */
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				text-align: center;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 100%;
				aspect-ratio: 1 / 1;
				object-fit: cover; 
				object-position: center;
				
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
				word-break: keep-all; /* 한글 단어가 어색하게 잘리지 않게 함 */
        		overflow-wrap: break-word; /* 너무 긴 영어 단어는 줄바꿈 */
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
		@media (max-width: 720px) {
				main {
					padding: 0 16px; /* 모바일 전용 여백 */
				}
				ul {
					gap: 1.5rem;
				}
				ul li {
					width: 100%; /* 모바일에선 한 줄에 하나씩 */
				}
				.title {
					font-size: 1.2rem; /* 모바일에서 제목이 너무 크면 줄바꿈이 심해지니 조절 */
				}
			}
		</style>
	</head>
	<body>
		<div class="wrapper">
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		</div>
		<Footer />
	</body>
</html>
