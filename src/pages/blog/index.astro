---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import Layout from '../../layouts/Layout.astro';
import Search from "astro-pagefind/components/Search.astro";

const posts = (await getCollection('blog', ({ data }) => {
    // 빌드(운영) 환경일 때만 draft가 true가 아닌 글들만 통과시킴
    return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const publishedPostCount = posts.filter((post) => post.data.draft !== true).length;
---
<style is:global>
    /* Pagefind 겉 껍데기 및 내부 form 마진 강제 제거 */
    .pagefind-ui,
    .pagefind-ui .pagefind-ui__form {
        margin: 0 !important;
        padding: 0 !important;
        width: 100%;
    }
</style>

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<style slot="head">
		ul {
			display: flex;
			flex-direction: column; /* 세로 정렬 */
			gap: 1rem;
			list-style-type: none;
			margin: 0;
			padding: 2rem 1.5rem;
		}

		ul li {
			width: 100%;
			text-align: left; /* 블로그형이면 왼쪽 정렬이 더 자연스러움 */
		}

		ul li a {
			display: block;
			padding: 1rem 0;
			border-radius: 16px;
			text-decoration: none;
			transition: color 0.2s ease;
		}

		ul li a:hover {
			color: var(--link-hover-color);
		}

		.title {
			margin: 0;
			line-height: 1.4;
			font-size: 1.6rem; /* 제목 크게 */
			word-break: keep-all;
			overflow-wrap: break-word;
		}

		.date {
			margin: 0 0 0.4rem;
			color: var(--muted-text-color);
			font-size: 0.8rem;
			font-weight: 400;
		}

		.post-count {
			margin: 1.75rem 1.5rem 0.5rem;
			color: var(--muted-text-color);
			font-size: 0.9rem;
		}
	</style>

	<section data-pagefind-ignore>
		
		<ul>
			<Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, resetStyles: false }} />
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h4 class="title">{post.data.title}</h4>
						</a>
					</li>
				))
			}
		</ul>
		<p class="post-count">전체 포스트 {publishedPostCount}개</p>
	</section>
</Layout>