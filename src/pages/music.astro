---
import { readdir } from 'node:fs/promises';
import { dirname, extname, join, relative, resolve, sep } from 'node:path';
import AudioPlayer from '../components/AudioPlayer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import MusicEntryHeading from '../components/MusicEntryHeading.astro';
import {
	musicFolderMetadata,
	musicTrackMetadata,
} from '../data/musicMetadata';
import { musicEmbeds } from '../data/musicEmbeds';
import Layout from '../layouts/Layout.astro';

const musicRoot = resolve(process.cwd(), 'public/music');
const audioExtensions = new Set([
	'.3gp',
	'.aac',
	'.amr',
	'.aif',
	'.aiff',
	'.ape',
	'.dff',
	'.dsf',
	'.flac',
	'.m4a',
	'.mid',
	'.midi',
	'.mka',
	'.mp3',
	'.mp4',
	'.oga',
	'.ogg',
	'.opus',
	'.spx',
	'.tta',
	'.wav',
	'.webm',
	'.wma',
	'.wv',
]);

type MusicFile = {
	name: string;
	src: string;
	format: string;
	description: string;
	date?: Date;
};

type EmbeddedPlayer = {
	provider: string;
	src: string;
	height: number;
	date?: Date;
};

type EmbeddedMusic = {
	title: string;
	description: string;
	players: EmbeddedPlayer[];
};

function parseMusicDate(date?: string): Date | undefined {
	if (!date) return undefined;
	const timestamp = Date.parse(`${date}T00:00:00.000Z`);
	if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || Number.isNaN(timestamp) || new Date(timestamp).toISOString().slice(0, 10) !== date) {
		throw new Error(`음악 날짜는 YYYY-MM-DD 형식이어야 합니다: ${date}`);
	}
	return new Date(timestamp);
}

function createMusicPlayer({ url: rawUrl, date }: (typeof musicEmbeds)[number]['embeds'][number]): EmbeddedPlayer {
	let url: URL;
	try {
		url = new URL(rawUrl);
	} catch {
		throw new Error(`음악 임베드 URL이 올바르지 않습니다: ${rawUrl}`);
	}

	if (url.protocol !== 'https:') {
		throw new Error(`음악 임베드 URL은 HTTPS여야 합니다: ${rawUrl}`);
	}

	const hostname = url.hostname.toLowerCase().replace(/^www\./, '');
	if (hostname === 'youtube.com' || hostname === 'm.youtube.com' || hostname === 'music.youtube.com' || hostname === 'youtube-nocookie.com' || hostname === 'youtu.be') {
		const parts = url.pathname.split('/').filter(Boolean);
		const videoId = hostname === 'youtu.be'
			? parts[0]
			: url.searchParams.get('v') ?? (['embed', 'shorts', 'live'].includes(parts[0] ?? '') ? parts[1] : undefined);
		if (!videoId || !/^[\w-]{11}$/.test(videoId)) {
			throw new Error(`YouTube 동영상 URL을 확인해 주세요: ${rawUrl}`);
		}
		return {
			provider: 'YouTube',
			src: `https://www.youtube-nocookie.com/embed/${videoId}`,
			height: 315,
			date: parseMusicDate(date),
		};
	}

	if (hostname === 'soundcloud.com') {
		url.search = '';
		return {
			provider: 'SoundCloud',
			src: `https://w.soundcloud.com/player/?${new URLSearchParams({
				url: url.href,
				color: '#ff5500',
				auto_play: 'false',
				hide_related: 'true',
				show_comments: 'false',
				show_user: 'true',
				show_reposts: 'false',
				visual: 'false',
			})}`,
			height: 166,
			date: parseMusicDate(date),
		};
	}

	if (hostname === 'open.spotify.com') {
		const [type, id] = url.pathname.split('/').filter(Boolean);
		if (!['track', 'album', 'playlist', 'episode', 'show'].includes(type ?? '') || !id || !/^[\w]+$/.test(id)) {
			throw new Error(`Spotify 곡·앨범·플레이리스트 URL을 확인해 주세요: ${rawUrl}`);
		}
		return {
			provider: 'Spotify',
			src: `https://open.spotify.com/embed/${type}/${id}`,
			height: type === 'track' || type === 'episode' ? 152 : 352,
			date: parseMusicDate(date),
		};
	}

	throw new Error(`지원하지 않는 음악 서비스 URL입니다: ${rawUrl}`);
}

function createMusicEmbed({ title, embeds, description = '' }: (typeof musicEmbeds)[number]): EmbeddedMusic {
	if (embeds.length === 0) {
		throw new Error(`음악 섹션에 임베드 URL을 하나 이상 입력해 주세요: ${title}`);
	}
	return {
		title,
		description,
		players: embeds.map(createMusicPlayer),
	};
}

const folders = new Map<string, MusicFile[]>();

async function collectMusic(directory: string) {
	for (const entry of await readdir(directory, { withFileTypes: true })) {
		const fullPath = join(directory, entry.name);
		if (entry.isDirectory()) {
			await collectMusic(fullPath);
			continue;
		}

		const extension = extname(entry.name).toLowerCase();
		if (!entry.isFile() || !audioExtensions.has(extension)) continue;

		const relativePath = relative(musicRoot, fullPath);
		const folderPath = dirname(relativePath);
		const folder = folderPath === '.' ? '기타' : folderPath.split(sep).join('/');
		const files = folders.get(folder) ?? [];
		const metadata = musicTrackMetadata[relativePath];
		files.push({
			name: entry.name,
			src: `/music/${relativePath.split(sep).map(encodeURIComponent).join('/')}`,
			format: extension.slice(1).toUpperCase(),
			description: metadata?.description ?? '',
			date: parseMusicDate(metadata?.date),
		});
		folders.set(folder, files);
	}
}

await collectMusic(musicRoot);

const musicFolders = [...folders.entries()]
	.map(([name, files]) => {
		const metadata = musicFolderMetadata[name];
		return {
			name,
			description: metadata?.description ?? '',
			date: parseMusicDate(metadata?.date),
			files: files.sort((a, b) => a.name.localeCompare(b.name, 'ko')),
		};
	})
	.sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const totalTracks = musicFolders.reduce((count, folder) => count + folder.files.length, 0);
const embeddedMusic = musicEmbeds.map(createMusicEmbed);
const totalEmbeddedPlayers = embeddedMusic.reduce((count, music) => count + music.players.length, 0);
---

<Layout title="음악" description="폴더별로 모아 둔 음악을 감상해 보세요.">
	<header class="page-heading">
		<h1>음악</h1>
		<p class="summary">{musicFolders.length}개 폴더 · 총 {totalTracks + totalEmbeddedPlayers}개</p>
	</header>

	{musicFolders.length > 0 || embeddedMusic.length > 0 ? (
		<div class="folder-list">
			{musicFolders.map(({ name: folder, description, date, files }, index) => (
				<>
					<section class="folder" aria-labelledby={`folder-${folder}`}>
						<MusicEntryHeading
							title={folder}
							date={date}
							meta={`${files.length}곡`}
							description={description}
							id={`folder-${folder}`}
						/>
						<ul>
							{files.map((file) => (
								<li>
									{['MID', 'MIDI'].includes(file.format) ? (
										<>
											{file.date && <p class="music-date"><FormattedDate date={file.date} /></p>}
											<p class="download-title">{file.name}</p>
											{file.description && <p class="track-description">{file.description}</p>}
											<a class="download" href={file.src} download>파일 다운로드</a>
										</>
									) : (
										<AudioPlayer
											src={file.src}
											title={file.name}
											description={file.description}
											date={file.date}
										/>
									)}
								</li>
							))}
						</ul>
					</section>
					{(index < musicFolders.length - 1 || embeddedMusic.length > 0) && (
						<hr class="folder-divider" aria-hidden="true" />
					)}
				</>
			))}

			{embeddedMusic.length > 0 && (
				<section class="online-music" aria-label="온라인 음악">
					<div class="online-list">
						{embeddedMusic.map((music, index) => (
							<>
								<article class="music-embed">
									<MusicEntryHeading
										title={music.title}
										meta={music.players.map((player) => player.provider).join(' · ')}
										description={music.description}
									/>
									<div class="music-players">
										{music.players.map((player) => (
											<div class="music-player">
												{player.date && (
													<p class="music-player-date"><FormattedDate date={player.date} /></p>
												)}
												<iframe
													src={player.src}
													title={`${music.title} - ${player.provider} 플레이어`}
													loading="lazy"
													height={player.height}
													allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
													allowfullscreen
												/>
											</div>
										))}
									</div>
								</article>
								{index < embeddedMusic.length - 1 && (
									<hr class="folder-divider" aria-hidden="true" />
								)}
							</>
						))}
					</div>
				</section>
			)}
		</div>
	) : (
		<p class="empty">아직 등록된 음악이 없습니다.</p>
	)}

	<p>이것 외에도 제 음악은 아주 많습니다! <a href="https://www.youtube.com/@sinokadev">유튜브</a>나 <a href="https://soundcloud.com/sinokadev">사운드클라우드</a>, 그리고 제 <a href="https://www.youtube.com/channel/UCihs9DsOwq1MyUBrAXp-4pA">유튜브 토픽 페이지</a>와 <a href="https://open.spotify.com/artist/0kqGQnWAyC9Bk1gOS51hZR">스포티파이</a>, <a href="https://music.apple.com/us/artist/sinoka/1830279424">애플 뮤직</a>에서 들으실 수 있습니다.</p>
</Layout>

<style>
	.page-heading {
		margin: 1.5rem 0 2rem;
	}



	.eyebrow {
		margin: 0;
		color: var(--muted-text-color);
		font-size: 0.75rem;
		font-weight: var(--font-weight-post-date);
		letter-spacing: 0.12em;
	}

	h1 {
		margin: 0.3rem 0;
		font-weight: var(--font-weight-post-heading);
	}

	.summary {
		margin: 0;
		color: var(--muted-text-color);
	}

	.folder-list {
		--music-divider-gap: 1.5rem;
		display: grid;
		gap: var(--music-divider-gap);
	}

	.folder-divider {
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		border-top: 1px solid var(--bg-color-two);
	}

	.music-date {
		margin: 0 0 0.4rem;
		color: var(--muted-text-color);
		font-size: 0.8rem;
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.folder ul {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	li {
		padding: 0;
	}

	.folder :global(.audio-player) {
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	.folder :global(.audio-player figcaption) {
		font-weight: var(--font-weight-figcaption);
	}

	.download-title {
		margin: 0;
		font-size: 1.3rem;
		font-weight: var(--font-weight-post-heading);
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.track-description {
		margin: 0.25rem 0 0.75rem;
		color: var(--muted-text-color);
		font-size: 0.9rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.online-list {
		display: grid;
		gap: var(--music-divider-gap);
	}

	.music-embed {
		margin: 0;
	}

	.music-players {
		display: grid;
		gap: 1rem;
	}

	.music-player-date {
		margin: 0 0 0.4rem;
		color: var(--muted-text-color);
		font-size: 0.8rem;
	}

	.music-players iframe {
		display: block;
		width: 100%;
		border: 0;
		border-radius: var(--radius-image);
		background: var(--color-white);
	}

	.track-heading {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.4rem;
	}

	.download {
		font-size: 0.9rem;
	}

	.empty {
		padding: 2rem 1rem;
		color: var(--muted-text-color);
		text-align: center;
	}
</style>
