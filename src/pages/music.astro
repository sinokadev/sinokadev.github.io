---
import AudioPlayer from '../components/AudioPlayer.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import MusicEntryHeading from '../components/MusicEntryHeading.astro';
import Layout from '../layouts/Layout.astro';
import { getMusicData } from '../lib/music';

const {
	folders: musicFolders,
	embeddedMusic,
	totalTracks,
	totalEmbeddedPlayers,
	hasMusic,
} = await getMusicData();
---

<Layout title="음악" description="폴더별로 모아 둔 음악을 감상해 보세요.">
	<header class="page-heading">
		<h1>음악</h1>
		<p class="summary">{musicFolders.length}개 폴더 · 총 {totalTracks + totalEmbeddedPlayers}개</p>
	</header>

	{hasMusic ? (
		<div class="music-layout">
			<nav class="music-toc" aria-label="음악 목차">
				<p>목차</p>
				<ul>
					{musicFolders.map(({ name }, index) => (
						<li><a href={`#music-folder-${index}`}>{name}</a></li>
					))}
					{embeddedMusic.map((music, index) => (
						<li><a href={`#music-online-${index}`}>{music.title}</a></li>
					))}
				</ul>
			</nav>

			<div class="music-content">
				<div class="folder-list">
					{musicFolders.map(({ name: folder, description, date, files }, index) => (
						<>
							<section class="folder" aria-labelledby={`music-folder-${index}`}>
								<MusicEntryHeading
									title={folder}
									date={date}
									meta={`${files.length}곡`}
									description={description}
									id={`music-folder-${index}`}
								/>
								<ul>
									{files.map((file) => (
										<li>
											{file.isVideo ? (
												<VideoPlayer src={file.src} type={file.mimeType} title={file.name} description={file.description} />
											) : file.isMidi ? (
												<>
													{file.date && <p class="music-date"><FormattedDate date={file.date} /></p>}
													<p class="download-title">
														<a href={file.permalink} class="track-page-link">{file.name}</a>
													</p>
													{file.description && <p class="track-description">{file.description}</p>}
													<div class="file-links">
														<a class="download" href={file.src} download>파일 다운로드</a>
														<a class="track-detail-link" href={file.permalink}>전용 페이지 →</a>
													</div>
												</>
											) : (
												<AudioPlayer
													src={file.src}
													title={file.name}
													description={file.description}
													date={file.date}
													permalink={file.permalink}
												/>
											)}
										</li>
									))}
								</ul>
							</section>
							{(index < musicFolders.length - 1 || embeddedMusic.length > 0) && (
								<hr class="folder-divider" aria-hidden="true" />
							)}
						</>
					))}

					{embeddedMusic.length > 0 && (
						<section class="online-music" aria-label="온라인 음악">
							<div class="online-list">
								{embeddedMusic.map((music, index) => (
									<>
										<article class="music-embed">
											<MusicEntryHeading
												title={music.title}
												meta={music.players.map((player) => player.provider).join(' · ')}
												description={music.description}
												id={`music-online-${index}`}
											/>
											<div class="music-players">
												{music.players.map((player) => (
													<div class={`music-player music-player-${player.provider.toLowerCase()}`}>
														{player.date && (
															<p class="music-player-date"><FormattedDate date={player.date} /></p>
														)}
														<div
															class="music-player-frame"
															style={`--music-player-height: ${player.height}px`}
														>
															<iframe
																src={player.src}
																title={`${music.title} - ${player.provider} 플레이어`}
																loading="lazy"
																height={player.height}
																allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
																allowfullscreen
															/>
														</div>
													</div>
												))}
											</div>
										</article>
										{index < embeddedMusic.length - 1 && (
											<hr class="folder-divider" aria-hidden="true" />
										)}
									</>
								))}
							</div>
						</section>
					)}
				</div>

				<p>이것 외에도 제 음악은 아주 많습니다! <a href="https://www.youtube.com/@sinokadev">유튜브</a>나 <a href="https://soundcloud.com/sinokadev">사운드클라우드</a>, 그리고 제 <a href="https://www.youtube.com/channel/UCihs9DsOwq1MyUBrAXp-4pA">유튜브 토픽 페이지</a>와 <a href="https://open.spotify.com/artist/0kqGQnWAyC9Bk1gOS51hZR">스포티파이</a>, <a href="https://music.apple.com/us/artist/sinoka/1830279424">애플 뮤직</a>에서 들으실 수 있습니다.</p>
			</div>
		</div>
	) : (
		<p class="empty">아직 등록된 음악이 없습니다.</p>
	)}
</Layout>

<style>
	.page-heading {
		margin: 1.5rem 0 2rem;
	}

	.eyebrow {
		margin: 0;
		color: var(--muted-text-color);
		font-size: 0.75rem;
		font-weight: var(--font-weight-post-date);
		letter-spacing: 0.12em;
	}

	h1 {
		margin: 0.3rem 0;
		font-weight: var(--font-weight-post-heading);
	}

	.summary {
		margin: 0;
		color: var(--muted-text-color);
	}

	.music-layout {
		display: grid;
		grid-template-columns: minmax(120px, 1fr) minmax(0, 720px) minmax(120px, 1fr);
		gap: 1.5rem;
		align-items: start;
		width: min(1100px, calc(100vw - 2rem));
		max-width: 100%;
		margin-left: 50%;
		transform: translateX(-50%);
	}

	.music-toc {
		position: sticky;
		top: 1.5rem;
		grid-column: 1;
		grid-row: 1;
		justify-self: end;
		width: 100%;
		max-width: 140px;
		max-height: calc(100vh - 3rem);
		overflow-y: auto;
	}

	.music-toc > p {
		margin-bottom: 0.5rem;
		font-weight: var(--font-weight-post-heading);
	}

	.music-toc ul {
		display: grid;
		gap: 0.35rem;
		list-style: none;
	}

	.music-toc a {
		display: block;
		color: var(--muted-text-color);
		font-size: 0.85rem;
		line-height: 1.4;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.music-toc a:hover {
		color: var(--link-color);
	}

	.music-content {
		grid-column: 2;
		grid-row: 1;
		min-width: 0;
	}

	.music-content :global(h2[id]) {
		scroll-margin-top: 1.5rem;
	}

	.folder-list {
		--music-divider-gap: 1.5rem;
		display: grid;
		gap: var(--music-divider-gap);
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.folder-divider {
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		border-top: 1px solid var(--bg-color-two);
	}

	.music-date {
		margin: 0 0 0.4rem;
		color: var(--muted-text-color);
		font-size: 0.8rem;
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.folder ul {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	li {
		padding: 0;
	}

	.folder :global(.audio-player) {
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	.folder :global(.audio-player figcaption) {
		font-weight: var(--font-weight-figcaption);
	}

	.download-title {
		margin: 0;
		font-size: 1.3rem;
		font-weight: var(--font-weight-post-heading);
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.track-description {
		margin: 0.25rem 0 0.75rem;
		color: var(--muted-text-color);
		font-size: 0.9rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.online-list {
		display: grid;
		gap: var(--music-divider-gap);
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.music-embed {
		margin: 0;
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.music-players {
		display: grid;
		gap: 1rem;
	}

	.music-player {
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.music-player-frame {
		position: relative;
		width: 100%;
		max-width: 100%;
		height: var(--music-player-height);
		box-sizing: border-box;
	}

	.music-player-date {
		margin: 0 0 0.4rem;
		color: var(--muted-text-color);
		font-size: 0.8rem;
	}

	.music-player-frame iframe {
		display: block;
		width: 100%;
		max-width: 100%;
		height: 100%;
		border: 0;
		border-radius: var(--radius-image);
		background: var(--color-white);
	}

	.music-player-youtube .music-player-frame {
		height: auto;
		aspect-ratio: 16 / 9;
	}

	.music-player-youtube .music-player-frame iframe {
		position: absolute;
		inset: 0;
		height: 100%;
	}

	.track-heading {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.4rem;
	}

	.download {
		font-size: 0.9rem;
	}

	.file-links {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.25rem;
	}

	.track-page-link {
		color: inherit;
		text-decoration: none;
	}

	.track-page-link:hover {
		color: var(--link-color);
		text-decoration: underline;
	}

	.track-detail-link {
		font-size: 0.85rem;
		color: var(--muted-text-color);
		text-decoration: none;
	}

	.track-detail-link:hover {
		color: var(--link-color);
		text-decoration: underline;
	}

	.empty {
		padding: 2rem 1rem;
		color: var(--muted-text-color);
		text-align: center;
	}

	@media (max-width: 900px) {
		.music-layout {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			width: 100%;
			max-width: 100%;
			margin-left: 0;
			transform: none;
			overflow: visible;
		}

		.music-toc {
			position: -webkit-sticky;
			top: 0;
			z-index: 1;
			flex: none;
			align-self: stretch;
			width: 100%;
			max-width: none;
			max-height: none;
			padding: 0.5rem 0;
			background: var(--bg-color);
			border-bottom: 1px solid var(--bg-color-two);
			box-sizing: border-box;
			overflow: visible;
		}

		.music-toc > p {
			margin-bottom: 0.25rem;
		}

		.music-toc ul {
			display: flex;
			gap: 1rem;
			overflow-x: auto;
			white-space: nowrap;
			scrollbar-width: thin;
		}

		.music-toc a {
			white-space: nowrap;
		}

		.music-content {
			width: 100%;
			min-width: 0;
			max-width: 100%;
		}

		.folder,
		.online-music,
		.online-list,
		.music-embed,
		.music-players,
		.music-player,
		.music-player-frame {
			width: 100%;
			max-width: 100%;
			min-width: 0;
		}

		.folder ul,
		.folder li,
		.music-player-frame iframe {
			width: 100%;
			max-width: 100%;
			min-width: 0;
		}

		.music-content :global(h2[id]) {
			scroll-margin-top: 5.5rem;
		}
	}
</style>
