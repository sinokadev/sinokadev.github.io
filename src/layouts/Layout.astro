---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description, pagefindIgnore = false, ...headProps } = Astro.props;
---
<html lang="ko" data-pagefind-ignore={pagefindIgnore ? '' : undefined}>
    <head>
        <BaseHead title={title} description={description} {...headProps} />
        <slot name="head" />
        <style>
        main {
			width: 100%;
			max-width: 752px;
			margin: 0 auto auto auto;
			padding: 1em;
			color: var(--text-color);
		}
        </style>
    </head>
    <body>
        <div class="wrapper">
            <Header />
            <main>
                <slot /> </main>
        </div>
        <Footer />
    </body>
</html>
