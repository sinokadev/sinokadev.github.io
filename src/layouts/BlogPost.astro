---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from './Layout.astro';
import "katex/dist/katex.min.css";
import "littlefoot/dist/littlefoot.css";

type Props = CollectionEntry<'blog'>['data'] & { minutesRead?: string; noindex?: boolean };

const { title, description, pubDate, updatedDate, heroImage, minutesRead, draft = false, noindex = false } = Astro.props;
const giscusTheme = import.meta.env.DEV ? 'light' : 'https://sinoka.dev/giscus-theme.css';
---

<Layout title={title} description={description} pagefindIgnore={draft || noindex}>
	<style slot="head">
		main {
			width: 100%;
			max-width: 100%;
		}
		.hero-image {
			width: 100%;
		}
		.title {
			margin-bottom: 0.3em;
			padding: 0em 0 0.25em;
		}
		.title h1 {
			margin: 1rem 0 0.2em 0;
			line-height: 1.25;
		}
		.title h1.has-description {
			margin-bottom: 0.05em;
		}
		.description {
			margin: 0 0 0.15em;
			color: var(--color-gray-500);
			font-size: 1.05rem;
			font-weight: var(--font-weight-post-description);
			line-height: 1.4;
			word-break: keep-all;
		}
		.date {
			margin-top: 0.7em;
			margin-bottom: 0.15em;
			line-height: 1.5;
			font-size: 0.8em;
			color: var(--color-gray-400);
		}
		.last-updated-on {
			font-style: italic;
		}
		.post-content :global(a) {
			color: var(--color-link-post);
		}
		.post-content :global(a:hover) {
			color: var(--color-link-post-hover);
		}
		.post-content :global([data-footnotes] > h2) {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
		.prose :global(.giscus) {
			margin-top: 2rem;
		}

		hr {
			border: 0;
			border-top: 2px solid var(--color-rule);
			width: 50%;
			margin: 0;
		}

		h2 {
			font-size: 0.9rem;
			color: var(--color-heading-muted);
			font-weight: var(--font-weight-post-heading);
		}
		.post-content :global(.littlefoot) {
			--button-background-color: var(--color-gray-600);
			--button-active-background-color: var(--color-gray-900);
			--button-text-color: var(--color-white);
			--button-active-text-color: var(--color-white);
			--button-border-radius: 999px;
			--button-height: 1.1rem;
			--button-padding: 0 0.35rem;
		}
		.post-content :global(.littlefoot__popover) {
			--popover-background-color: var(--bg-color);
			--popover-text-color: var(--text-color);
			--popover-border: 1px solid var(--color-border-light);
			--popover-border-radius: var(--radius-blockquote);
			--popover-shadow: 0 0.35rem 1rem var(--menu-shadow);
			--popover-font-family: "Pretendard", ui-sans-serif, sans-serif, system-ui;
			--popover-font-size: 0.9rem;
			--popover-line-height: 1.6;
		}
	</style>
	{noindex && <meta slot="head" name="robots" content="noindex, nofollow" />}

	<article>
		<div class="hero-image">
			{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<h1 class:list={{ 'has-description': Boolean(description) }}>{title}</h1>
				{description && <p class="description">{description}</p>}
				<hr />
				<div class="date">
					<div class="date-container">
						<FormattedDate date={pubDate} showTime />
						{minutesRead && (
							<>
								<span class="separator"> • </span>
								<span>{minutesRead}</span>
							</>
						)}
					</div>
					{updatedDate && (
						<div class="last-updated-on">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
			</div>
			<div class="post-content">
				<slot />
			</div>
			<script>
				import { littlefoot } from 'littlefoot';

				const initializeLittlefoot = () => {
					if (!document.querySelector('.post-content a[data-footnote-ref]')) return;

					littlefoot({
						scope: '.post-content',
						// GFM uses both numeric IDs (fn-1) and named IDs (fn-source-name).
						// Repeated references can also add a suffix, such as fn-1-2.
						anchorPattern: /#(?:user-content-)?fn-[\w-]+/i,
						buttonTemplate: '<button class="littlefoot__button" id="<% reference %>" title="See Footnote <% number %>"><svg role="img" aria-labelledby="title-<% reference %>" viewBox="0 0 6 6"><title id="title-<% reference %>">Footnote <% number %></title><circle r="3" cx="3" cy="3" fill="white"></circle></svg></button>',
						allowMultiple: false,
						activateOnHover: false,
						dismissOnDocumentTouch: true,
					});
				};

				initializeLittlefoot();
			</script>
			<script src="https://giscus.app/client.js"
					data-repo="sinokadev/blog-giscus"
					data-repo-id="R_kgDORKSjOA"
					data-category="General"
					data-category-id="DIC_kwDORKSjOM4C1-ky"
					data-mapping="url"
					data-strict="0"
					data-reactions-enabled="1"
					data-emit-metadata="0"
					data-input-position="bottom"
					data-theme={giscusTheme}
					data-lang="ko"
					data-loading="lazy"
					crossorigin="anonymous"
					async>
			</script>
		</div>
	</article>
</Layout>
