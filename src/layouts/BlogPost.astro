---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from './Layout.astro';
import "katex/dist/katex.min.css";

type Props = CollectionEntry<'blog'>['data'] & { minutesRead?: string };

const { title, description, pubDate, updatedDate, heroImage, minutesRead, draft = false } = Astro.props;
const giscusTheme = import.meta.env.DEV ? 'light' : 'https://sinoka.dev/giscus-theme.css';
---

<Layout title={title} description={description} pagefindIgnore={draft}>
	<style slot="head">
		main {
			width: calc(100% - 2em);
			max-width: 100%;
		}
		.hero-image {
			width: 100%;
			margin-bottom: 2rem; /* 본문과의 간격 */
			
		}
		.prose {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 1em;
			color: rgb(var(--gray-dark));
		}
		.title {
			margin-bottom: 0.3em;
			padding: 1em 0 0.25em;
			line-height: 1;
		}
		.title h1 {
			margin: 0 0 0.5em 0;
		}
		.title h1.has-description {
			margin-bottom: 0.25em;
		}
		.description {
			margin: 0.1em 0 0.4em;
			color: #777;
			font-size: 1.05rem;
			font-weight: 400;
			line-height: 1.7;
			word-break: keep-all;
		}
		.date {
			margin-top: 0.7em;
			margin-bottom: 0.15em;
			line-height: 1.5;
			font-size: 0.8em;
			color: #888;
		}
		.last-updated-on {
			font-style: italic;
		}
		.post-content :global(a) {
			color: #0066cc;
		}
		.post-content :global(a:hover) {
			color: #004c99;
		}

		hr {
			border: 0;
			border-top: 2px solid rgb(180, 180, 180);
			margin: 2rem 0;
			width: 50%;
			margin: 0;
		}

		h2 {
			font-size: 0.9rem;
			color: rgb(131, 131, 131);
			font-weight: normal;
		}
	</style>

	<article>
		<div class="hero-image">
			{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<h1 class:list={{ 'has-description': Boolean(description) }}>{title}</h1>
				{description && <p class="description">{description}</p>}
				<hr />
				<div class="date">
					<div class="date-container">
						<FormattedDate date={pubDate} showTime />
						{minutesRead && (
							<>
								<span class="separator"> • </span>
								<span>{minutesRead}</span>
							</>
						)}
					</div>
					{updatedDate && (
						<div class="last-updated-on">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
			</div>
			<div class="post-content">
				<slot />
			</div>
			<script src="https://giscus.app/client.js"
					data-repo="sinokadev/blog-giscus"
					data-repo-id="R_kgDORKSjOA"
					data-category="General"
					data-category-id="DIC_kwDORKSjOM4C1-ky"
					data-mapping="url"
					data-strict="0"
					data-reactions-enabled="1"
					data-emit-metadata="0"
					data-input-position="bottom"
					data-theme={giscusTheme}
					data-lang="ko"
					data-loading="lazy"
					crossorigin="anonymous"
					async>
			</script>
		</div>
	</article>
</Layout>
