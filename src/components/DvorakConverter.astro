---
// Astro Component Server Frontmatter
---

<div class="kbd-converter">
  <h2>QWERTY ⇄ 2벌식 ⇄ Dvorak 변환기</h2>
  <p class="desc">
    같은 물리 키를 눌렀을 때 각 자판 배열에서 나오는 글자를 서로 변환해요.
  </p>

  <div class="section">
    <div class="label-row">
      <label for="kbd-qwerty">QWERTY (영문)</label>
      <span class="btns">
        <button type="button" data-copy="qwerty">복사</button>
        <button type="button" data-clear>전체 지우기</button>
      </span>
    </div>
    <textarea id="kbd-qwerty" data-layout="qwerty" placeholder="QWERTY 자판으로 친 글자..." spellcheck="false"></textarea>
  </div>

  <div class="section">
    <div class="label-row">
      <label for="kbd-hangul">한글 (2벌식)</label>
      <span class="btns">
        <button type="button" data-copy="hangul">복사</button>
      </span>
    </div>
    <textarea id="kbd-hangul" data-layout="hangul" placeholder="2벌식 한글로 친 글자..." spellcheck="false"></textarea>
  </div>

  <div class="section">
    <div class="label-row">
      <label for="kbd-dvorak">Dvorak (영문)</label>
      <span class="btns">
        <button type="button" data-copy="dvorak">복사</button>
      </span>
    </div>
    <textarea id="kbd-dvorak" data-layout="dvorak" placeholder="Dvorak 자판으로 친 글자..." spellcheck="false"></textarea>
  </div>
</div>

<script>
  type Layout = 'qwerty' | 'hangul' | 'dvorak';

  // ───────────────────────────────────────────────
  // 1. QWERTY <-> Dvorak (물리 키 위치 기준)
  // ───────────────────────────────────────────────
  const Q_LOWER = "`1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./";
  const D_LOWER = "`1234567890[]',.pyfgcrl/=\\aoeuidhtns-;qjkxbmwvz";
  const Q_UPPER = "~!@#$%^&*()_+QWERTYUIOP{}|ASDFGHJKL:\"ZXCVBNM<>?";
  const D_UPPER = "~!@#$%^&*(){}\"<>PYFGCRL?+|AOEUIDHTNS_:QJKXBMWVZ";

  const qwertyToDvorak: Record<string, string> = {};
  const dvorakToQwerty: Record<string, string> = {};
  for (const [qs, ds] of [[Q_LOWER, D_LOWER], [Q_UPPER, D_UPPER]]) {
    for (let i = 0; i < qs.length; i++) {
      qwertyToDvorak[qs[i]] = ds[i];
      dvorakToQwerty[ds[i]] = qs[i];
    }
  }

  // ───────────────────────────────────────────────
  // 2. QWERTY 키 <-> 2벌식 자모
  // ───────────────────────────────────────────────
  const KEY_TO_JAMO: Record<string, string> = {
    q: 'ㅂ', w: 'ㅈ', e: 'ㄷ', r: 'ㄱ', t: 'ㅅ', y: 'ㅛ', u: 'ㅕ', i: 'ㅑ', o: 'ㅐ', p: 'ㅔ',
    a: 'ㅁ', s: 'ㄴ', d: 'ㅇ', f: 'ㄹ', g: 'ㅎ', h: 'ㅗ', j: 'ㅓ', k: 'ㅏ', l: 'ㅣ',
    z: 'ㅋ', x: 'ㅌ', c: 'ㅊ', v: 'ㅍ', b: 'ㅠ', n: 'ㅜ', m: 'ㅡ',
  };
  // Shift 를 눌렀을 때 자모가 달라지는 키
  const SHIFT_JAMO: Record<string, string> = {
    Q: 'ㅃ', W: 'ㅉ', E: 'ㄸ', R: 'ㄲ', T: 'ㅆ', O: 'ㅒ', P: 'ㅖ',
  };

  const JAMO_TO_KEY: Record<string, string> = {};
  for (const [k, j] of Object.entries(KEY_TO_JAMO)) JAMO_TO_KEY[j] = k;
  for (const [k, j] of Object.entries(SHIFT_JAMO)) JAMO_TO_KEY[j] = k;

  // 겹모음 / 겹받침을 키 두 개로 풀 때 사용
  const COMPOUND_KEYS: Record<string, string> = {
    'ㅘ': 'hk', 'ㅙ': 'ho', 'ㅚ': 'hl',
    'ㅝ': 'nj', 'ㅞ': 'np', 'ㅟ': 'nl', 'ㅢ': 'ml',
    'ㄳ': 'rt', 'ㄵ': 'sw', 'ㄶ': 'sg',
    'ㄺ': 'fr', 'ㄻ': 'fa', 'ㄼ': 'fq', 'ㄽ': 'ft',
    'ㄾ': 'fx', 'ㄿ': 'fv', 'ㅀ': 'fg', 'ㅄ': 'qt',
  };

  const CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
  const JUNG = ['ㅏ','ㅐ','ㅑ','ㅒ','ㅓ','ㅔ','ㅕ','ㅖ','ㅗ','ㅘ','ㅙ','ㅚ','ㅛ','ㅜ','ㅝ','ㅞ','ㅟ','ㅠ','ㅡ','ㅢ','ㅣ'];
  const JONG = ['','ㄱ','ㄲ','ㄳ','ㄴ','ㄵ','ㄶ','ㄷ','ㄹ','ㄺ','ㄻ','ㄼ','ㄽ','ㄾ','ㄿ','ㅀ','ㅁ','ㅂ','ㅄ','ㅅ','ㅆ','ㅇ','ㅈ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];

  const DOUBLE_JUNG: Record<string, string> = {
    'ㅗㅏ': 'ㅘ', 'ㅗㅐ': 'ㅙ', 'ㅗㅣ': 'ㅚ',
    'ㅜㅓ': 'ㅝ', 'ㅜㅔ': 'ㅞ', 'ㅜㅣ': 'ㅟ',
    'ㅡㅣ': 'ㅢ',
  };
  const DOUBLE_JONG: Record<string, string> = {
    'ㄱㅅ': 'ㄳ', 'ㄴㅈ': 'ㄵ', 'ㄴㅎ': 'ㄶ',
    'ㄹㄱ': 'ㄺ', 'ㄹㅁ': 'ㄻ', 'ㄹㅂ': 'ㄼ', 'ㄹㅅ': 'ㄽ',
    'ㄹㅌ': 'ㄾ', 'ㄹㅍ': 'ㄿ', 'ㄹㅎ': 'ㅀ', 'ㅂㅅ': 'ㅄ',
  };
  const SPLIT_JONG: Record<string, [string, string]> = {};
  for (const [pair, merged] of Object.entries(DOUBLE_JONG)) {
    SPLIT_JONG[merged] = [pair[0], pair[1]];
  }

  const VOWELS = new Set(['ㅏ','ㅐ','ㅑ','ㅒ','ㅓ','ㅔ','ㅕ','ㅖ','ㅗ','ㅛ','ㅜ','ㅠ','ㅡ','ㅣ']);

  function keyToJamo(k: string): string | null {
    if (SHIFT_JAMO[k]) return SHIFT_JAMO[k];
    const lower = k.toLowerCase();
    return KEY_TO_JAMO[lower] ?? null;
  }

  function jamoToKeys(j: string): string | null {
    if (COMPOUND_KEYS[j]) return COMPOUND_KEYS[j];
    return JAMO_TO_KEY[j] ?? null;
  }

  // 한글 -> 물리 키(QWERTY 문자) 시퀀스
  function hangulToKeys(text: string): string {
    let keys = '';
    for (const ch of text) {
      const code = ch.codePointAt(0)!;
      if (code >= 0xac00 && code <= 0xd7a3) {
        const s = code - 0xac00;
        const cho = Math.floor(s / 588);
        const jung = Math.floor((s % 588) / 28);
        const jong = s % 28;
        keys += jamoToKeys(CHO[cho]) ?? '';
        keys += jamoToKeys(JUNG[jung]) ?? '';
        if (jong) keys += jamoToKeys(JONG[jong]) ?? '';
      } else {
        keys += jamoToKeys(ch) ?? ch;
      }
    }
    return keys;
  }

  // 물리 키 시퀀스 -> 한글 (2벌식 오토마타)
  function keysToHangul(keys: string): string {
    let out = '';
    let cho = '', jung = '', jong = '';

    const flush = () => {
      if (cho && jung) {
        const code =
          0xac00 + (CHO.indexOf(cho) * 21 + JUNG.indexOf(jung)) * 28 + (jong ? JONG.indexOf(jong) : 0);
        out += String.fromCharCode(code);
      } else {
        out += cho + jung + jong;
      }
      cho = jung = jong = '';
    };

    for (const k of keys) {
      const j = keyToJamo(k);

      if (!j) {
        flush();
        out += k;
        continue;
      }

      if (VOWELS.has(j)) {
        if (!cho) {
          out += j;
          continue;
        }
        if (!jung) {
          jung = j;
          continue;
        }
        if (!jong) {
          const merged = DOUBLE_JUNG[jung + j];
          if (merged) {
            jung = merged;
          } else {
            flush();
            out += j;
          }
          continue;
        }
        // 받침이 있는 상태에서 모음 -> 받침(의 일부)이 다음 글자 초성으로 이동
        let nextCho: string;
        const split = SPLIT_JONG[jong];
        if (split) {
          jong = split[0];
          nextCho = split[1];
        } else {
          nextCho = jong;
          jong = '';
        }
        flush();
        cho = nextCho;
        jung = j;
        continue;
      }

      // 자음
      if (!cho) {
        cho = j;
        continue;
      }
      if (!jung) {
        flush();
        cho = j;
        continue;
      }
      if (!jong) {
        if (JONG.includes(j)) {
          jong = j;
        } else {
          flush();
          cho = j;
        }
        continue;
      }
      const merged = DOUBLE_JONG[jong + j];
      if (merged) {
        jong = merged;
      } else {
        flush();
        cho = j;
      }
    }
    flush();
    return out;
  }

  // ───────────────────────────────────────────────
  // 3. 레이아웃별 변환 함수
  // ───────────────────────────────────────────────
  const mapChars = (text: string, map: Record<string, string>) =>
    Array.from(text, (ch) => map[ch] ?? ch).join('');

  const toKeys: Record<Layout, (t: string) => string> = {
    qwerty: (t) => t,
    dvorak: (t) => mapChars(t, dvorakToQwerty),
    hangul: hangulToKeys,
  };

  const fromKeys: Record<Layout, (k: string) => string> = {
    qwerty: (k) => k,
    dvorak: (k) => mapChars(k, qwertyToDvorak),
    hangul: keysToHangul,
  };

  // ───────────────────────────────────────────────
  // 4. DOM 연결
  // ───────────────────────────────────────────────
  const layouts: Layout[] = ['qwerty', 'hangul', 'dvorak'];
  const els = {} as Record<Layout, HTMLTextAreaElement>;
  for (const l of layouts) {
    els[l] = document.querySelector(`textarea[data-layout="${l}"]`) as HTMLTextAreaElement;
  }

  function sync(source: Layout) {
    const keys = toKeys[source](els[source].value);
    for (const l of layouts) {
      if (l !== source) els[l].value = fromKeys[l](keys);
    }
  }

  for (const l of layouts) {
    els[l]?.addEventListener('input', () => sync(l));
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const l = btn.dataset.copy as Layout;
      try {
        await navigator.clipboard.writeText(els[l].value);
        const prev = btn.textContent;
        btn.textContent = '복사됨!';
        setTimeout(() => (btn.textContent = prev), 1000);
      } catch {
        els[l].select();
      }
    });
  });

  document.querySelector('button[data-clear]')?.addEventListener('click', () => {
    for (const l of layouts) els[l].value = '';
  });
</script>

<style>
  .kbd-converter {
    --kbd-bg: #ffffff;
    --kbd-fg: #1f2328;
    --kbd-border: #d0d7de;
    --kbd-accent: #3b82f6;
    --kbd-muted: #656d76;
    max-width: 720px;
    margin: 0 auto;
    padding: 1.25rem;
    color: var(--kbd-fg);
  }
  @media (prefers-color-scheme: dark) {
    .kbd-converter {
      --kbd-bg: #161b22;
      --kbd-fg: #e6edf3;
      --kbd-border: #30363d;
      --kbd-muted: #8b949e;
    }
  }
  h2 {
    margin: 0 0 0.25rem;
  }
  .desc {
    margin: 0 0 1.25rem;
    color: var(--kbd-muted);
    font-size: 0.9rem;
  }
  .section {
    margin-bottom: 1rem;
  }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .btns {
    display: flex;
    gap: 0.4rem;
  }
  button {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--kbd-border);
    border-radius: 6px;
    background: transparent;
    color: var(--kbd-fg);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--kbd-accent);
    color: var(--kbd-accent);
  }
  textarea {
    width: 100%;
    min-height: 6rem;
    box-sizing: border-box;
    padding: 0.6rem 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Noto Sans KR', monospace;
    font-size: 1rem;
    line-height: 1.5;
    background: var(--kbd-bg);
    color: var(--kbd-fg);
    border: 1px solid var(--kbd-border);
    border-radius: 8px;
    resize: vertical;
  }
  textarea:focus {
    outline: 2px solid var(--kbd-accent);
    outline-offset: -1px;
  }
</style>