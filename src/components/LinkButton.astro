---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  link?: string;
}

const { link, href, class: className, ...rest } = Astro.props;
const targetHref = link ?? href;
---

<a href={targetHref} class:list={['link-button', className]} {...rest}>
  <slot />
</a>

<style>
.link-button {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  
  background-color: var(--color-link-button-bg) !important;
  
  line-height: 1; 
  padding: 0.45rem 0.5rem; 
  border-radius: var(--radius-link-button);
  font-size: 0.85rem;
  color: var(--color-black) !important;
  text-decoration: none;
  transition: background-color 0.2s ease;
  cursor: pointer;

  margin-right: 0.5rem;
  margin-bottom: 0.5rem;
}

  .link-button:hover {
    background-color: var(--color-link-button-hover-bg);
  }

</style>