---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	ogType?: string;
	audio?: {
		url: string;
		type: string;
	};
	video?: {
		url: string;
		type: string;
		width?: number;
		height?: number;
	};
	twitterCard?: 'summary' | 'summary_large_image' | 'player';
	twitterPlayer?: {
		url: string;
		width?: number;
		height?: number;
		stream?: string;
		streamType?: string;
	};
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	ogType = 'website',
	audio,
	video,
	twitterCard = 'summary_large_image',
	twitterPlayer,
} = Astro.props;

const imageURL = image
	? typeof image === 'string'
		? new URL(image, Astro.site).href
		: new URL(image.src, Astro.site).href
	: undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}
{audio && (
	<>
		<meta property="og:audio" content={audio.url} />
		<meta property="og:audio:secure_url" content={audio.url} />
		<meta property="og:audio:type" content={audio.type} />
	</>
)}
{video && (
	<>
		<meta property="og:video" content={video.url} />
		<meta property="og:video:secure_url" content={video.url} />
		<meta property="og:video:type" content={video.type} />
		<meta property="og:video:width" content={String(video.width ?? 1200)} />
		<meta property="og:video:height" content={String(video.height ?? 500)} />
	</>
)}

<!-- Twitter -->
<meta name="twitter:card" property="twitter:card" content={twitterCard} />
<meta name="twitter:url" property="twitter:url" content={Astro.url} />
<meta name="twitter:title" property="twitter:title" content={title} />
<meta name="twitter:description" property="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" property="twitter:image" content={imageURL} />}
{twitterPlayer && (
	<>
		<meta name="twitter:player" property="twitter:player" content={twitterPlayer.url} />
		<meta name="twitter:player:width" property="twitter:player:width" content={String(twitterPlayer.width ?? 1200)} />
		<meta name="twitter:player:height" property="twitter:player:height" content={String(twitterPlayer.height ?? 500)} />
		{twitterPlayer.stream && (
			<>
				<meta name="twitter:player:stream" property="twitter:player:stream" content={twitterPlayer.stream} />
				<meta name="twitter:player:stream:content_type" property="twitter:player:stream:content_type" content={twitterPlayer.streamType ?? 'video/mp4'} />
			</>
		)}
	</>
)}

<script defer src="https://cloud.umami.is/script.js" data-website-id="b3880911-8acb-4cea-a27c-8bc6530fbd8c"></script>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
  integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFas9aVVUsq"
  crossorigin="anonymous"
/>