---
interface Props {
  targetDate: string; // 예: "2027-01-01" 또는 "2027-01-01T00:00:00+09:00"
  label?: string;     // 카운트다운 대상 이름 (선택사항)
}

const { targetDate } = Astro.props;
---

<section class="countdown" aria-live="polite" aria-atomic="true" data-target={targetDate}>
  <p class="countdown-number">계산 중…</p>
  <p class="countdown-time"></p>
</section>

<style>
  .countdown {
    margin: 2rem 0;
    padding: 2rem 1rem;
    text-align: center;
  }
  .countdown-number {
    margin: 0;
    font-size: clamp(3rem, 14vw, 7rem);
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .countdown-time {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  function initCountdowns() {
    const countdownElements = document.querySelectorAll<HTMLElement>('.countdown');

    countdownElements.forEach((container) => {
      const numberEl = container.querySelector('.countdown-number');
      const timeEl = container.querySelector('.countdown-time');
      const targetAttr = container.dataset.target;

      if (!numberEl || !timeEl || !targetAttr) return;

      // 지정된 목표 날짜 Parse
      const targetTime = new Date(targetAttr).getTime();

      function updateCountdown() {
        const now = Date.now();
        const remaining = targetTime - now;

        // KST 기준 오늘 0시 UTC Timestamp 구하기
        const kstToday = new Date(now + 9 * 60 * 60 * 1000);
        const todayAtUtc = Date.UTC(
          kstToday.getUTCFullYear(),
          kstToday.getUTCMonth(),
          kstToday.getUTCDate()
        );

        // 목표 날짜 KST 기준 0시 UTC Timestamp 구하기
        const targetObj = new Date(targetAttr);
        const kstTarget = new Date(targetTime + 9 * 60 * 60 * 1000);
        const targetAtUtc = Date.UTC(
          kstTarget.getUTCFullYear(),
          kstTarget.getUTCMonth(),
          kstTarget.getUTCDate()
        );

        const calendarDays = Math.round((targetAtUtc - todayAtUtc) / 86_400_000);

        if (calendarDays > 0) {
          numberEl.textContent = `D-${calendarDays}`;
        } else if (calendarDays === 0) {
          numberEl.textContent = 'D-DAY';
        } else {
          numberEl.textContent = `D+${Math.abs(calendarDays)}`;
        }

        const duration = Math.abs(remaining);
        const days = Math.floor(duration / 86_400_000);
        const hours = Math.floor((duration % 86_400_000) / 3_600_000);
        const minutes = Math.floor((duration % 3_600_000) / 60_000);
        const seconds = Math.floor((duration % 60_000) / 1_000);
        const clock = [hours, minutes, seconds]
          .map((part) => String(part).padStart(2, '0'))
          .join(':');

        timeEl.textContent = remaining >= 0
          ? `남은 시간 ${days}일 ${clock}`
          : `지난 시간 ${days}일 ${clock}`;
      }

      updateCountdown();
      window.setInterval(updateCountdown, 1_000);
    });
  }

  // 초기 실행
  initCountdowns();
</script>