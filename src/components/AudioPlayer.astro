---
interface Props {
	src: string;
	title?: string;
	description?: string;
	date?: Date;
}

import FormattedDate from './FormattedDate.astro';

const { src, title, description, date } = Astro.props;
---

<figure class="audio-player">
	{title && (
		<figcaption>
			<span>{title}</span>
			{date && <FormattedDate date={date} />}
		</figcaption>
	)}
	{description && <p class="description">{description}</p>}
	<audio-player>
		<audio-neutral-skin class="neutral-audio-skin">
			<audio preload="metadata" src={src}>
				<a href={src}>오디오 파일을 열 수 없습니다.</a>
			</audio>
		</audio-neutral-skin>
	</audio-player>
</figure>

<script>
	import '@videojs/html/audio/player';
	import '@videojs/html/audio/neutral-skin';
</script>

<style>
	.audio-player {
		margin: 0.5rem 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-gray-200);
		border-radius: var(--radius-image);
		background: var(--color-white);
	}

	.audio-player figcaption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0 0 0.35rem;
		text-align: left;
		font-weight: var(--font-weight-figcaption);
	}

	.audio-player figcaption :global(time) {
		flex: none;
		color: var(--muted-text-color);
		font-size: 0.8rem;
		font-weight: var(--font-weight-post-date);
	}

	.description {
		margin: 0 0 0.5rem;
		color: var(--muted-text-color);
		font-size: 0.9rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	audio-neutral-skin {
		display: block;
		width: 100%;
	}
</style>
