---
interface Props {
	src: string;
	title?: string;
	description?: string;
	date?: Date;
	permalink?: string;
}

import FormattedDate from './FormattedDate.astro';

const { src, title, description, date, permalink } = Astro.props;
---

<figure class="audio-player">
	{title && (
		<figcaption>
			<div class="caption-title-wrap">
				{permalink ? (
					<a href={permalink} class="track-link" title="개별 페이지로 이동">
						<span class="track-title-text">{title}</span>
						<svg class="external-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
							<polyline points="15 3 21 3 21 9" />
							<line x1="10" y1="14" x2="21" y2="3" />
						</svg>
					</a>
				) : (
					<span class="track-title-text">{title}</span>
				)}
			</div>
			{date && <FormattedDate date={date} />}
		</figcaption>
	)}
	{description && <p class="description">{description}</p>}
	<audio-player>
		<audio-neutral-skin class="neutral-audio-skin">
			<audio preload="metadata" src={src}>
				<a href={src}>오디오 파일을 열 수 없습니다.</a>
			</audio>
		</audio-neutral-skin>
	</audio-player>
</figure>

<script>
	import '@videojs/html/audio/player';
	import '@videojs/html/audio/neutral-skin';
</script>

<style>
	.audio-player {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin: 0.5rem 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-gray-200);
		border-radius: var(--radius-image);
		background: var(--color-white);
	}

	audio-player,
	audio-neutral-skin {
		display: block;
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.audio-player figcaption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0 0 0.35rem;
		text-align: left;
		font-weight: var(--font-weight-figcaption);
	}

	.caption-title-wrap {
		display: flex;
		align-items: center;
		min-width: 0;
		overflow: hidden;
	}

	.track-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: inherit;
		text-decoration: none;
		min-width: 0;
		overflow: hidden;
	}

	.track-link:hover {
		color: var(--link-color);
		text-decoration: underline;
	}

	.track-title-text {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.external-icon {
		flex: none;
		opacity: 0.6;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.track-link:hover .external-icon {
		opacity: 1;
	}

	.audio-player figcaption :global(time) {
		flex: none;
		color: var(--muted-text-color);
		font-size: 0.8rem;
		font-weight: var(--font-weight-post-date);
	}

	.description {
		margin: 0 0 0.5rem;
		color: var(--muted-text-color);
		font-size: 0.9rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	audio-neutral-skin {
		display: block;
		width: 100%;
	}
</style>
