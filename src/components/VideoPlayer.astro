---
interface Props {
	src: string;
	type: string;
	title?: string;
	description?: string;
}

const { src, type, title, description } = Astro.props;
---

<figure class="video-player">
	{title && <figcaption>{title}</figcaption>}
	{description && <p class="description">{description}</p>}
	<video controls preload="metadata" playsinline>
		<source src={src} type={type} />
		이 브라우저에서는 동영상을 재생할 수 없습니다.
	</video>
</figure>

<style>
	.video-player {
		width: 100%;
		margin: 0;
	}

	.video-player figcaption {
		margin: 0 0 0.35rem;
		font-weight: var(--font-weight-figcaption);
	}

	.description {
		margin: 0 0 0.5rem;
		color: var(--muted-text-color);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	video {
		display: block;
		width: 100%;
		max-height: 70vh;
		border-radius: 6px;
		background: #000;
	}
</style>
